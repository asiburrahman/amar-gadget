datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  password     String?
  avatar       String?
  phone        String?
  role         String      @default("USER") // USER, MEMBER (Seller), ADMIN
  sellerStatus String      @default("APPROVED") // APPROVED, PENDING, BLOCKED, REJECTED
  isVerified   Boolean     @default(false)
  sessionVersion Int       @default(0)
  wishlistVersion Int      @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products    Product[]
  orders      Order[]
  reviews     Review[]
  wishlists   Wishlist[]
  addresses   Address[]
  cart        Cart?
  otpTokens   OtpToken[]
  otpThrottles OtpThrottle[]
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  image       String?
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Brand {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  logo        String?
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Product {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  description   String?
  specifications Json      @default("[]")
  price         Decimal     @db.Decimal(10, 2)
  discountPrice Decimal?    @db.Decimal(10, 2)
  stock         Int
  imageUrl      String?
  images        String[]    @default([])
  mediaVersion  Int         @default(1)
  isFeatured    Boolean     @default(false)
  status        String      @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  
  sellerId      String
  seller        User        @relation(fields: [sellerId], references: [id])
  
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  
  brandId       String?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  wishlists     Wishlist[]
  campaigns     CampaignProduct[]
}

model ProductImageCleanup {
  key String @id @db.VarChar(160)
  ownerId String @db.VarChar(64)
  availableAt DateTime
  attempts Int @default(0)
  lastError String? @db.VarChar(100)
  createdAt DateTime @default(now())
  @@index([availableAt, key])
}

model Campaign {
  id String @id @default(uuid())
  title String @db.VarChar(120)
  slug String @unique @db.VarChar(120)
  description String @default("") @db.VarChar(1000)
  startsAt DateTime
  endsAt DateTime
  isActive Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products CampaignProduct[]
  @@index([isActive, startsAt, endsAt])
}

model CampaignProduct {
  campaignId String
  productId String
  position Int
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([campaignId, productId])
  @@unique([campaignId, position])
  @@index([productId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  total           Decimal     @db.Decimal(10, 2)
  status          String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentMethod   String      @default("COD") // COD, STRIPE
  paymentStatus   String      @default("UNPAID") // UNPAID, PAID, FAILED
  paymentIntentId String?
  checkoutTokenHash String? @unique
  checkoutRequestHash String? @db.VarChar(64)
  reservationExpiresAt DateTime?
  reservationNextCheckAt DateTime?
  reservationReviewReason String?
  stripeSessionRequestedAt DateTime?
  stripeCheckoutSessionId String? @unique
  stripeCheckoutOrigin String?
  stripeCheckoutVersion Int @default(1)
  shippingAddress String?
  shippingPhone   String?
  shippingCarrier String? @db.VarChar(80)
  shipmentTrackingNumber String? @db.VarChar(120)
  trackingNumber  String?
  couponCode      String?
  cartSnapshot    Json?
  cartConsumedAt  DateTime?
  cartAcknowledgedAt DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  items           OrderItem[]
  events          OrderEvent[]

  @@index([paymentMethod, status, paymentStatus, reservationNextCheckAt], map: "Order_reservation_sweep_idx")
  @@index([userId, createdAt(sort: Desc)], map: "Order_userId_createdAt_idx")
}

model Cart {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int @default(0)
  couponCode String? @db.VarChar(64)
  couponVersion Int @default(0)
  lastRequestId String? @db.VarChar(36)
  lastRequestHash String? @db.VarChar(64)
  lastResult Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines CartLine[]
}

model CartLine {
  id String @id @default(uuid())
  cartUserId String
  cart Cart @relation(fields: [cartUserId], references: [userId], onDelete: Cascade)
  // Soft catalog reference: deleted/hidden products remain removable without
  // product deletion cascading into a customer's cart or changing its version.
  productId String @db.VarChar(64)
  quantity Int
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartUserId, productId])
  @@index([cartUserId, createdAt, id])
}

model OrderEvent {
  id                     String @id @default(uuid())
  sequence               BigInt @unique @default(autoincrement())
  orderId                String
  order                  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                   String
  previousStatus         String?
  status                 String?
  previousPaymentStatus  String?
  paymentStatus          String?
  shippingCarrier        String? @db.VarChar(80)
  shipmentTrackingNumber String? @db.VarChar(120)
  occurredAt             DateTime?
  recordedAt             DateTime @default(now())

  @@index([orderId, sequence])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt, id])
}

model Address {
  id         String   @id @default(uuid())
  version    Int      @default(1)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  phone      String
  street     String
  city       String
  district   String
  zipCode    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  // At most one default per user is enforced by the partial unique index
  // Address_one_default_per_user in the reviewed SQL migration.
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  discount    Decimal   @db.Decimal(10, 2) // Percent or fixed amount
  isPercentage Boolean  @default(true)
  minSpend    Decimal?  @db.Decimal(10, 2)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  purpose   String
  codeHash  String @db.VarChar(64)
  accountFingerprint String @db.VarChar(64)
  attempts Int @default(0)
  deliveredAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, purpose])
  @@index([email, purpose, expiresAt])
}

model OtpThrottle {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  verificationWindowStart DateTime @default(now())
  verificationAttempts Int @default(0)
  sendWindowStart DateTime @default(now())
  sendCount Int @default(0)
  lastSentAt DateTime?

  @@id([userId, purpose])
}
